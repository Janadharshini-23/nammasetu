# --- Database ---
# Leave unset to use local SQLite (schemesetu.db). For Neon/Postgres:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Optional AI assistant (any OpenAI-compatible API: OpenAI, Groq, Ollama, vLLM) ---
# The model name must be one that exists on whichever provider LLM_BASE_URL points to.
#
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
# Groq (free tier, fast, recommended for local dev):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-20b

# --- CORS: comma-separated frontend origins ---
CORS_ORIGINS=http://localhost:3000
